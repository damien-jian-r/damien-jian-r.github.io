<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign posters = data[1] | sort: 'date' | reverse %}
  {% for content in posters %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
            {{ content.date }}
          </span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.name }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
            {{ content.event -}}
            {%- if content.location %}, {{ content.location }}{% endif %}
          </h6>
          {% if content.organizers %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.organizers }}</h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
